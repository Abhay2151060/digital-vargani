# Database Connection String (PostgreSQL 14+)
DATABASE_URL=postgresql://vargani_user:vargani_password@localhost:5432/vargani_db

# API Server Port & Environment Configuration
PORT=4000
NODE_ENV=development

# Authentication & JWT Secrets (required outside development/test; use a strong unique value)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Comma-separated frontend origins, required in production (for example https://app.example.com)
CORS_ORIGINS=http://localhost:3000

# Frontend Web Application Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000
